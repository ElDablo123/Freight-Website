---
import Layout from '~/layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import { Mail, Phone, Award, Briefcase, BookOpen } from 'lucide-react';
// Import placeholder image
import placeholderImage from '~/assets/images/placeholder.png';
const metadata = {
  title: 'Attorney Profile | Freight Collection Solutions Law Group, PLLC',
};

// Example attorney data
const attorney = {
  name: 'Example Attorney',
  title: 'Partner',
  image: placeholderImage,
  email: 'example@freight-cs.com',
  phone: '(346) 574-3483',
  education: [
    'J.D., University of Houston Law Center',
    'B.A., University of Texas'
  ],
  barAdmissions: [
    'State Bar of Texas',
    'U.S. District Court, Southern District of Texas'
  ],
  experience: [
    'Over 10 years of experience in collections and transportation law',
    'Recovered millions for transportation industry clients',
    'Background in freight and logistics law'
  ],
  practiceFocus: [
    'Transportation Collections',
    'Commercial Litigation',
    'Contract Disputes',
    'Freight Claims'
  ],
  bio: `Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nullam in dui mauris. Vivamus hendrerit arcu sed erat molestie vehicula. Sed auctor neque eu tellus rhoncus ut eleifend nibh porttitor. Ut in nulla enim.

  Phasellus molestie magna non est bibendum non venenatis nisl tempor. Suspendisse dictum feugiat nisl ut dapibus. Mauris iaculis porttitor posuere. Praesent id metus massa, ut blandit odio.`,
  publications: [
    '"Collections Strategies in the Transportation Industry" - Journal of Transportation Law, 2021',
    '"Legal Challenges for Freight Carriers" - Logistics Monthly, 2020'
  ],
  speaking: [
    'Transportation Law Conference - "Modern Collection Techniques", 2022',
    'Logistics Summit - "Legal Frameworks in Freight", 2021'
  ]
};
---

<Layout metadata={metadata}>
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <!-- Attorney Header -->
      <div class="flex flex-col md:flex-row gap-8 mb-12">
        <div class="md:w-1/3">
          <div class="rounded-lg overflow-hidden shadow-xl">
            <Image 
              src={attorney.image} 
              alt={attorney.name}
              class="w-full object-cover"
              width={500}
              height={600}
            />
          </div>
        </div>
        <div class="md:w-2/3">
          <h1 class="text-4xl font-bold text-gray-800 mb-2">{attorney.name}</h1>
          <p class="text-2xl text-orange-500 mb-6">{attorney.title}</p>
          
          <div class="flex items-center mb-4">
            <Mail className="w-5 h-5 text-blue-800 mr-3" />
            <a href={`mailto:${attorney.email}`} class="text-blue-800 hover:underline">{attorney.email}</a>
          </div>
          
          <div class="flex items-center mb-8">
            <Phone className="w-5 h-5 text-blue-800 mr-3" />
            <a href={`tel:${attorney.phone.replace(/\D/g,'')}`} class="text-blue-800 hover:underline">{attorney.phone}</a>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-indigo-50 rounded-lg p-4">
              <h2 class="text-lg font-semibold text-blue-800 mb-3 flex items-center">
                <Award className="w-5 h-5 mr-2" /> Education
              </h2>
              <ul class="list-disc list-inside space-y-2 text-gray-700">
                {attorney.education.map(item => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
            
            <div class="bg-indigo-50 rounded-lg p-4">
              <h2 class="text-lg font-semibold text-blue-800 mb-3 flex items-center">
                <Briefcase className="w-5 h-5 mr-2" /> Bar Admissions
              </h2>
              <ul class="list-disc list-inside space-y-2 text-gray-700">
                {attorney.barAdmissions.map(item => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Attorney Biography -->
      <div class="mb-16">
        <h2 class="text-2xl font-bold text-blue-800 mb-6 pb-2 border-b border-indigo-100">Biography</h2>
        <div class="text-gray-700 space-y-4">
          {attorney.bio.split('\n\n').map(paragraph => (
            <p>{paragraph}</p>
          ))}
        </div>
      </div>
      
      <!-- Experience & Expertise -->
      <div class="grid md:grid-cols-2 gap-8 mb-16">
        <div>
          <h2 class="text-2xl font-bold text-blue-800 mb-6 pb-2 border-b border-indigo-100">Experience Highlights</h2>
          <ul class="space-y-3">
            {attorney.experience.map(item => (
              <li class="flex items-start">
                <span class="text-orange-500 mr-2">✓</span>
                <span class="text-gray-700">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <div>
          <h2 class="text-2xl font-bold text-blue-800 mb-6 pb-2 border-b border-indigo-100">Practice Focus</h2>
          <div class="flex flex-wrap gap-3">
            {attorney.practiceFocus.map(focus => (
              <span class="px-4 py-2 bg-blue-100 text-blue-800 rounded-full text-sm font-medium">
                {focus}
              </span>
            ))}
          </div>
        </div>
      </div>
      
      <!-- Publications & Speaking -->
      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <h2 class="text-2xl font-bold text-blue-800 mb-6 pb-2 border-b border-indigo-100 flex items-center">
            <BookOpen className="w-5 h-5 mr-2" /> Publications
          </h2>
          <ul class="space-y-4">
            {attorney.publications.map(pub => (
              <li class="flex items-start">
                <span class="text-orange-500 mr-2">•</span>
                <span class="text-gray-700">{pub}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <div>
          <h2 class="text-2xl font-bold text-blue-800 mb-6 pb-2 border-b border-indigo-100">Speaking Engagements</h2>
          <ul class="space-y-4">
            {attorney.speaking.map(item => (
              <li class="flex items-start">
                <span class="text-orange-500 mr-2">•</span>
                <span class="text-gray-700">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
      
      <!-- Back to Team Button -->
      <div class="mt-16 text-center">
        <a 
          href="/team" 
          class="inline-block bg-blue-800 text-white px-8 py-3 rounded-lg hover:bg-blue-700 transition-colors"
        >
          Back to Team
        </a>
      </div>
    </div>
  </section>
</Layout>
